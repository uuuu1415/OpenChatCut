<UserControl x:Class="OpenChatCut.Native.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">
  <Grid Margin="34,30,34,26">
    <StackPanel MaxWidth="720">
      <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="原生客户端的运行状态与数据边界。" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,26" />
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="18" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="运行时" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
          <Grid Margin="0,18,0,0">
            <TextBlock Text="UI 渲染" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <TextBlock Text="WPF native controls" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" />
          </Grid>
          <Grid Margin="0,9,0,0">
            <TextBlock Text="浏览器壳" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <TextBlock Text="未使用" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="18">
        <StackPanel>
          <TextBlock Text="本地数据" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="工程、媒体索引、Agent 会话与导出任务继续使用 OpenChatCut 的本地存储目录。原生界面只通过受保护的 loopback service contract 访问它们。" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
