<UserControl x:Class="OpenChatCut.Native.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">
  <Grid Margin="34,30,34,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <StackPanel>
        <TextBlock Text="工程" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="管理本地视频工程，继续你的下一次剪辑。" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Content="刷新" Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
        <Button Content="＋ 新建工程" Style="{StaticResource PrimaryButton}" Command="{Binding CreateProjectCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="#0E141E" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,26,0,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="2,0,12,0" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Projects}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="310" Height="188" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,16,16" Padding="16">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                  <Border Width="34" Height="34" CornerRadius="9" Background="#252B3B" HorizontalAlignment="Left">
                    <TextBlock Text="▶" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="LOCAL PROJECT" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,8">
                  <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                  <TextBlock Text="本地工程 · 可继续编辑" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                  <Button Content="打开工程  →" Style="{StaticResource QuietButton}" Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                  <Button Content="复制" Style="{StaticResource QuietButton}" Margin="6,0,0,0" Padding="9,8" Command="{Binding DataContext.DuplicateProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                  <Button Content="删除" Style="{StaticResource QuietButton}" Margin="6,0,0,0" Padding="9,8" Foreground="{StaticResource CoralBrush}" Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
