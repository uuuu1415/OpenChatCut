<Application x:Class="OpenChatCut.Native.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenChatCut.Native.ViewModels"
             xmlns:views="clr-namespace:OpenChatCut.Native.Views"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#0B0F16" />
    <SolidColorBrush x:Key="PanelBrush" Color="#111722" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#171F2D" />
    <SolidColorBrush x:Key="LineBrush" Color="#253044" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F5F8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8D99AA" />
    <SolidColorBrush x:Key="CoralBrush" Color="#FF765F" />
    <SolidColorBrush x:Key="BlueBrush" Color="#62B5FF" />
    <SolidColorBrush x:Key="GreenBrush" Color="#61D0A4" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#10131A" />
      <Setter Property="Background" Value="{StaticResource CoralBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CoralBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CaretBrush" Value="{StaticResource CoralBrush}" />
    </Style>

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EditorViewModel}">
      <views:EditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Application.Resources>
</Application>
